#!/bin/bash
set -euo pipefail

while ! flatpak ps --columns=application | grep -q "io.gitlab.librewolf-community"
do 
    sleep 5
done

BASE="$HOME/.var/app/io.gitlab.librewolf-community/.librewolf"
PROFILE=$(find "$BASE" -maxdepth 1 -type d -name "*.default*" | while read r; do echo "$(find "$r" | wc -l) $r"; done | sort -rn | head -n 1 | cut -d" " -f2-)

if [ -n "$PROFILE" ]; then
    CHROME_DIR="$PROFILE/chrome"
    mkdir -p "$CHROME_DIR"

    ln -sfn /etc/mozilla/browser/gnome "$CHROME_DIR/firefox-gnome-theme"
    ln -sfn /etc/mozilla/browser/csshacks "$CHROME_DIR/firefox-csshacks"
    touch "$CHROME_DIR/userChrome.css"

    if ! grep -q "firefox-gnome-theme/userChrome.css" "$CHROME_DIR/userChrome.css"; then
        echo '@import "firefox-gnome-theme/userChrome.css";' >> "$CHROME_DIR/userChrome.css"
    fi

    if ! grep -q "firefox-csshacks/chrome/compact_extensions_panel.css" "$CHROME_DIR/userChrome.css"; then
        echo '@import "firefox-csshacks/chrome/compact_extensions_panel.css";' >> "$CHROME_DIR/userChrome.css"
    fi

    rm -f "$HOME/.config/autostart/librewolf-css.desktop"
fi
