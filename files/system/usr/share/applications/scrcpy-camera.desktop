[Desktop Entry]
Name=scrcpy (Camera)
GenericName=Android Camera Mirror
Comment=Use your Android device as a webcam via v4l2
# You can use `ujust scrcpy-cam edit` to configure scrcpy to your liking.
Exec=ujust scrcpy-cam
Icon=scrcpy
Terminal=true
Type=Application
Categories=Utility;Video;
StartupNotify=false
